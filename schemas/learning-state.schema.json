{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-everything.local/schemas/learning-state.schema.json",
  "title": "LearnEverything v1 learning state",
  "description": "A compact, explanation-first state for one local learner and at most one resumable session.",
  "$comment": "The CLI additionally enforces IDs unique within their containing array, selected_option_id references within its question, may_cover references within the open session, one open session, expected-revision writes, and adaptation lifecycle transitions. last_evidence_session_id is provenance and need not reference a retained session row.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "learner", "topic_memories", "open_session", "updated_at"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "learner": { "$ref": "#/$defs/learner" },
    "topic_memories": {
      "type": "array",
      "description": "Summaries written only after sessions close; never a copy of current open-session progress.",
      "items": { "$ref": "#/$defs/topicMemory" }
    },
    "open_session": {
      "oneOf": [
        { "$ref": "#/$defs/openSession" },
        { "type": "null" }
      ]
    },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "canonicalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_preferences", "concept_notes", "adaptation_signals"],
      "properties": {
        "explicit_preferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/explicitPreference" }
        },
        "concept_notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/conceptNote" }
        },
        "adaptation_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/adaptationSignal" }
        }
      }
    },
    "explicitPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preference_id", "scope", "instruction", "updated_at"],
      "properties": {
        "preference_id": { "$ref": "#/$defs/identifier" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 200 },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 500 },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "conceptNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_key", "summary", "state", "basis", "last_observed_at"],
      "properties": {
        "concept_key": { "$ref": "#/$defs/canonicalKey" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "state": {
          "type": "string",
          "description": "A routing hint, not mastery.",
          "enum": ["known", "partial", "needs_revisit"]
        },
        "basis": {
          "type": "string",
          "enum": ["user_declared", "diagnostic_observation", "closed_topic"]
        },
        "last_observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "adaptationSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "scope",
        "condition",
        "strategy",
        "status",
        "support_count",
        "last_evidence_session_id",
        "basis_summary",
        "last_observed_at"
      ],
      "properties": {
        "signal_id": { "$ref": "#/$defs/identifier" },
        "scope": { "$ref": "#/$defs/canonicalKey" },
        "condition": { "$ref": "#/$defs/canonicalKey" },
        "strategy": { "$ref": "#/$defs/canonicalKey" },
        "status": { "type": "string", "enum": ["candidate", "active", "inactive"] },
        "support_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "last_evidence_session_id": { "$ref": "#/$defs/identifier" },
        "basis_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "A compact direct-feedback basis without raw conversation text."
        },
        "last_observed_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "candidate" } }, "required": ["status"] },
          "then": { "properties": { "support_count": { "const": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
          "then": { "properties": { "support_count": { "const": 2 } } }
        },
        {
          "if": { "properties": { "status": { "const": "inactive" } }, "required": ["status"] },
          "then": { "properties": { "support_count": { "const": 0 } } }
        }
      ]
    },
    "completionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "description", "status"],
      "properties": {
        "item_id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "covered"] }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "target_depth": {
          "type": "string",
          "enum": ["orientation", "explain", "apply", "independent"]
        },
        "completion_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/completionItem" }
        }
      }
    },
    "diagnosis": {
      "oneOf": [
        { "$ref": "#/$defs/diagnosisAwaitingAnswers" },
        { "$ref": "#/$defs/diagnosisComplete" }
      ]
    },
    "diagnosisAwaitingAnswers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "questions"],
      "properties": {
        "phase": { "const": "awaiting_answers" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/diagnosticQuestion" }
        }
      }
    },
    "diagnosticQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "prompt", "options"],
      "properties": {
        "question_id": { "$ref": "#/$defs/identifier" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/diagnosticOption" },
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "unknown_or_guessing" } }
          },
          "minContains": 1
        },
        "selected_option_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "diagnosticOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label", "kind"],
      "properties": {
        "option_id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "kind": {
          "type": "string",
          "enum": ["answer", "unknown_or_guessing", "cannot_parse_options"]
        }
      }
    },
    "diagnosisComplete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "basis", "starting_point", "summary"],
      "properties": {
        "phase": { "const": "complete" },
        "basis": {
          "type": "string",
          "enum": [
            "questions",
            "prior_context",
            "user_statement",
            "refusal_as_unknown",
            "conservative_fallback",
            "mixed"
          ]
        },
        "starting_point": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "summary": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/diagnosticFinding" }
        }
      }
    },
    "diagnosticFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_key", "starting_state"],
      "properties": {
        "concept_key": { "$ref": "#/$defs/canonicalKey" },
        "starting_state": {
          "type": "string",
          "enum": ["known", "partial", "unknown", "possible_misconception", "cannot_parse_language"]
        }
      }
    },
    "confusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "kind"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "kind": {
          "type": "string",
          "enum": [
            "missing_prerequisite",
            "unfamiliar_term",
            "skipped_step",
            "unsuitable_example",
            "too_abstract",
            "too_detailed",
            "other",
            "unknown"
          ]
        }
      }
    },
    "localTeachingNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "condition", "strategy", "outcome", "summary", "observed_at"],
      "properties": {
        "scope": { "$ref": "#/$defs/canonicalKey" },
        "condition": { "$ref": "#/$defs/canonicalKey" },
        "strategy": { "$ref": "#/$defs/canonicalKey" },
        "outcome": { "type": "string", "enum": ["helped", "hindered"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "teachingState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_summary",
        "unresolved_confusions",
        "local_teaching_notes",
        "current_focus",
        "next_move"
      ],
      "properties": {
        "confirmed_summary": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4000 },
            { "type": "null" }
          ]
        },
        "unresolved_confusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/confusion" }
        },
        "local_teaching_notes": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/localTeachingNote" }
        },
        "current_focus": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "next_move": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "unconfirmedUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "may_cover"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "may_cover": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "openSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "topic_id",
        "topic_title",
        "status",
        "revision",
        "goal",
        "diagnosis",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "session_id": { "$ref": "#/$defs/identifier" },
        "topic_id": { "$ref": "#/$defs/identifier" },
        "topic_title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "revision": { "type": "integer", "minimum": 1 },
        "goal": { "$ref": "#/$defs/goal" },
        "diagnosis": { "$ref": "#/$defs/diagnosis" },
        "teaching_state": { "$ref": "#/$defs/teachingState" },
        "unconfirmed_unit": { "$ref": "#/$defs/unconfirmedUnit" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "diagnosis": {
                "type": "object",
                "properties": { "phase": { "const": "complete" } },
                "required": ["phase"]
              }
            },
            "required": ["diagnosis"]
          },
          "then": {
            "required": ["teaching_state"],
            "properties": {
              "goal": { "required": ["purpose", "target_depth", "completion_items"] }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["teaching_state"] },
                { "required": ["unconfirmed_unit"] }
              ]
            },
            "properties": {
              "goal": { "not": { "required": ["completion_items"] } }
            }
          }
        }
      ]
    },
    "topicMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id",
        "title",
        "goal",
        "summary",
        "unresolved_questions",
        "close_reason",
        "closed_at"
      ],
      "properties": {
        "topic_id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true
        },
        "goal": {
          "allOf": [
            { "$ref": "#/$defs/goal" },
            { "required": ["purpose", "target_depth", "completion_items"] }
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "unresolved_questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "suggested_next_step": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "source_links": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "uniqueItems": true
        },
        "close_reason": { "type": "string", "enum": ["scope_delivered", "user_stopped"] },
        "closed_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "close_reason": { "const": "scope_delivered" } },
            "required": ["close_reason"]
          },
          "then": {
            "properties": {
              "goal": {
                "properties": {
                  "completion_items": {
                    "items": {
                      "type": "object",
                      "properties": { "status": { "const": "covered" } },
                      "required": ["status"]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "close_reason": { "const": "user_stopped" } },
            "required": ["close_reason"]
          },
          "then": {
            "required": ["suggested_next_step"],
            "properties": {
              "goal": {
                "properties": {
                  "completion_items": {
                    "contains": {
                      "type": "object",
                      "properties": { "status": { "const": "pending" } },
                      "required": ["status"]
                    },
                    "minContains": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
